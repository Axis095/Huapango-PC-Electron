{
  "name": "huapango-app",
  "version": "1.0.0",
  "main": "main.js",
  "description": "Aplicación de registro para el evento Huapango",
  "author": "Perro Virolo Industries",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "electron-builder",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "mysql2": "^3.24.4",
    "pdfkit": "^0.17.1"
  },
  "devDependencies": {
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.huapango.app",
    "productName": "HuapangoApp",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "Public/**/*",
      "Vistas/**/*",
      "!config.json",
      "!config.json.*"
    ],
    "extraResources": [
      {
        "from": "uploads",
        "to": "uploads"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "Public/images/icono.ico"
    }
  }
}