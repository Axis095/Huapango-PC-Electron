{
  "name": "huapango-app",
  "version": "1.0.0",
  "main": "main.js",
  "description": "Aplicación de registro para el evento Huapango",
  "author": "Perro Virolo Industries",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "electron scripts/smoke-fase0.cjs",
    "build": "electron-builder",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "mysql2": "^3.24.4",
    "pdfkit": "^0.17.1"
  },
  "devDependencies": {
    "electron": "^44.4.0",
    "electron-builder": "^26.5.0"
  },
  "build": {
    "appId": "com.huapango.app",
    "productName": "HuapangoApp",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "Public/**/*",
      "Vistas/**/*",
      "!.tmp/**/*",
      "!tests/**/*",
      "!scripts/**/*",
      "!docs/**/*",
      "!uploads/**/*",
      "!config.json",
      "!config.json.*"
    ],
    "win": {
      "target": "nsis",
      "icon": "Public/images/icono.ico"
    }
  }
}
