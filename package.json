{
  "name": "huapango-app",
  "version": "1.0.0",
  "main": "main.js",
  "description": "Aplicación de registro para el evento Huapango",
  "author": "Perro Virolo Industries",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/desarrollo.mjs",
    "start": "electron .",
    "compile:main": "node scripts/compilar-main.cjs",
    "compile": "node scripts/compilar-app.mjs",
    "typecheck": "tsc --project tsconfig.main.json --noEmit",
    "start:compiled": "electron build/app",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "electron scripts/smoke-fase0.cjs",
    "test:smoke:dev": "node scripts/desarrollo.mjs --smoke",
    "test:integration": "node scripts/integracion-fase0.cjs",
    "build": "electron-builder",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "mysql2": "^3.24.4",
    "pdfkit": "^0.17.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "^44.4.0",
    "electron-builder": "^26.5.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.huapango.app",
    "productName": "HuapangoApp",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "package.json",
      "Controladores/**/*",
      "Modelos/**/*",
      "Seguridad/**/*",
      "Servicios/**/*",
      "Public/**/*",
      "Vistas/**/*",
      "!.tmp/**/*",
      "!tests/**/*",
      "!scripts/**/*",
      "!docs/**/*",
      "!uploads/**/*",
      "!config.json",
      "!config.json.*"
    ],
    "win": {
      "target": "nsis",
      "icon": "Public/images/icono.ico"
    }
  }
}
